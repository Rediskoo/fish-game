generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FishSpecies {
  GOLDFISH
  GUPPY
  BETTA
  NEON_TETRA
  ANGELFISH
  DISCUS
  MANDARINFISH
  DRAGON_KOI
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum TransactionType {
  INCOME
  PURCHASE_FISH
  PURCHASE_FOOD
  PURCHASE_ITEM
  FEED
  DAILY_REWARD
  ACHIEVEMENT
  SELL_FISH
  GIFT_SENT
  GIFT_RECEIVED
  BREEDING_START
  BREEDING_SPEEDUP
  BREEDING_COMPLETE
  PURCHASE_BREEDING_ITEM
}

enum FishLifeStage {
  EGG
  EMBRYO
  HATCHING
  FRY
  BABY
  ADULT
}

enum FishOrigin {
  STARTER
  SHOP
  CASE
  BRED
}

enum BreedingStatus {
  INCUBATING
  READY_TO_HATCH
  HATCHED
  GROWING
  READY_TO_GROW
  COMPLETED
  CANCELLED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GiftType {
  FISH_CASE
  OWNED_FISH
  ALGAE_25
  ALGAE_50
  ALGAE_75
  ALGAE_100
}

enum FishPersonality {
  CURIOUS
  CALM
  LAZY
  SOCIAL
  SHY
  AGGRESSIVE
  PLAYFUL
}

model User {
  id                String        @id @default(cuid())
  telegramId        BigInt        @unique
  username          String?
  firstName         String?
  lastName          String?
  photoUrl          String?
  currency          Int           @default(0)
  lastLoginAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  aquarium          Aquarium?
  fish              Fish[]
  inventory         Inventory?
  transactions      Transaction[]
  dailyRewards      DailyReward[]
  achievements      UserAchievement[]
  friends           Friend[]          @relation("UserFriends")
  friendOf          Friend[]          @relation("FriendOf")
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  sentGifts              FriendGift[]    @relation("SentFriendGifts")
  receivedGifts          FriendGift[]    @relation("ReceivedFriendGifts")
  breedingJobs           BreedingJob[]

  @@map("users")
}

model Aquarium {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  name            String   @default("My Aquarium")
  level           Int      @default(1)
  experience      Int      @default(0)
  lastIncomeAt    DateTime @default(now())
  backgroundId     String   @default("deep-lagoon")
  decor           Json     @default("[]")
  pollution       Int      @default(0)
  lastPollutionAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("aquariums")
}

model FishType {
  id                 String      @id @default(cuid())
  species            FishSpecies
  rarity             Rarity
  displayName        String
  dropChanceBps      Int
  incomePerSecond    Float
  swimSpeed          Float
  hungerPerMinute    Int         @default(1)
  maxHunger          Int         @default(100)
  experienceReward   Int         @default(10)
  color              String
  glowColor          String
  createdAt          DateTime    @default(now())
  fish               Fish[]

  @@unique([species, rarity])
  @@map("fish_types")
}

model Fish {
  id                 String      @id @default(cuid())
  ownerId            String
  fishTypeId         String
  name               String
  isFavorite         Boolean     @default(false)
  isGiftLocked       Boolean     @default(false)
  personality        FishPersonality @default(CURIOUS)
  descriptionSeed    Int         @default(0)
  incomeMultiplier   Float       @default(1)
  swimSpeed          Float
  hunger             Int         @default(0)
  hungerUpdatedAt    DateTime    @default(now())
  animationState     Json        @default("{}")
  lifeStage          FishLifeStage @default(ADULT)
  origin             FishOrigin    @default(CASE)
  genome             Json?
  genomeVersion      String?
  hybridKey          String?
  parentAId          String?
  parentBId          String?
  parentSnapshots    Json?
  bornAt             DateTime?
  breedingLocked     Boolean       @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  owner              User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fishType           FishType    @relation(fields: [fishTypeId], references: [id])
  giftedIn           FriendGift[]
  parentAJobs        BreedingJob[] @relation("BreedingParentA")
  parentBJobs        BreedingJob[] @relation("BreedingParentB")
  resultingJob       BreedingJob?  @relation("BreedingResult")

  @@index([ownerId])
  @@map("fish")
}

model Inventory {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  food        Int      @default(0)
  bigFood     Int      @default(0)
  superFood   Int      @default(0)
  cleaner     Int      @default(0)
  superCleaner Int    @default(0)
  spawningNest Int     @default(0)
  eggIncubator Int     @default(0)
  fryFood      Int     @default(0)
  nurseryConditioner Int @default(0)
  genealogyMedallion Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model BreedingJob {
  id               String         @id @default(cuid())
  ownerId          String
  parentAId        String?
  parentBId        String?
  parentA          Fish?          @relation("BreedingParentA", fields: [parentAId], references: [id], onDelete: SetNull)
  parentB          Fish?          @relation("BreedingParentB", fields: [parentBId], references: [id], onDelete: SetNull)
  parentASnapshot  Json
  parentBSnapshot  Json
  hybridKey        String
  genome           Json
  genomeVersion    String         @default("1.0.0")
  rarity           Rarity
  status           BreedingStatus @default(INCUBATING)
  startedAt        DateTime       @default(now())
  hatchAt          DateTime
  babyAt           DateTime
  adultAt          DateTime
  claimedAt        DateTime?
  resultingFishId  String?        @unique
  resultingFish    Fish?          @relation("BreedingResult", fields: [resultingFishId], references: [id], onDelete: SetNull)
  idempotencyKey   String
  speedupsUsed     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, status])
  @@index([parentAId])
  @@index([parentBId])
  @@map("breeding_jobs")
}

model Transaction {
  id          String          @id @default(cuid())
  ownerId     String
  type        TransactionType
  amount      Int
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now())
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("transactions")
}

model DailyReward {
  id          String   @id @default(cuid())
  ownerId     String
  rewardDate  DateTime
  amount      Int
  claimedAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, rewardDate])
  @@map("daily_rewards")
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  title       String
  description String
  reward      Int
  createdAt   DateTime          @default(now())
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id             String      @id @default(cuid())
  ownerId        String
  achievementId  String
  unlockedAt     DateTime    @default(now())
  owner          User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  achievement    Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([ownerId, achievementId])
  @@map("user_achievements")
}

model BotNotification {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())

  @@map("bot_notifications")
}

model Friend {
  id          String   @id @default(cuid())
  ownerId     String
  friendId    String
  createdAt   DateTime @default(now())
  owner       User     @relation("UserFriends", fields: [ownerId], references: [id], onDelete: Cascade)
  friend      User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
  @@index([friendId])
  @@map("friends")
}

model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sender      User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friend_requests")
}

model FriendGift {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  type        GiftType
  amount      Int      @default(0)
  fishId      String?
  claimedAt   DateTime?
  createdAt   DateTime @default(now())
  sender      User     @relation("SentFriendGifts", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedFriendGifts", fields: [receiverId], references: [id], onDelete: Cascade)
  fish        Fish?    @relation(fields: [fishId], references: [id], onDelete: SetNull)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, claimedAt])
  @@map("friend_gifts")
}
